# Mode server configuration
# Copy to .env and fill in what you need. Every setting is optional: with no
# keys, Mode works fully offline (photos, paint, materials, lighting, plants,
# asset list); only the AI features are turned off.
# `npm run dev` and `npm start` load .env automatically. Restart after changes.

# --- Claude (AI analysis, design ideas, asset-list pricing, drawn assets) ------
# Anthropic API key from https://console.anthropic.com. Setting it turns AI on.
ANTHROPIC_API_KEY=

# Force AI on or off. "on" enables AI without ANTHROPIC_API_KEY, using other
# Anthropic credentials the SDK can find (ANTHROPIC_AUTH_TOKEN or a profile
# saved by `ant auth login`). "off" disables AI even when a key is set.
# MODE_AI=on

# Claude model used for every AI feature.
# CLAUDE_MODEL=claude-opus-5-5

# --- Image provider (photoreal renders and photo-style assets) ---------------
# Set to "openai" to enable; leave unset to disable.
# IMAGE_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OpenAI-compatible endpoint (proxy or gateway). Default:
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Access & limits -----------------------------------------------------------
# Shared secret for every /api request except /api/health. Strongly recommended
# whenever the server is reachable by other devices (phones on your Wi-Fi, a
# public host), so nobody else can spend your API credits. Enter the same value
# in the app under Settings > Server access token.
# MODE_ACCESS_TOKEN=

# Max AI requests per client IP per 10 minutes (0 = unlimited).
# RATE_LIMIT_PER_10MIN=60

# Set to "true" only behind a trusted reverse proxy, so the rate limit uses the
# X-Forwarded-For / X-Real-IP client address instead of the proxy's.
# TRUST_PROXY=false

# --- Server ------------------------------------------------------------------
# Port of the API server (production serves the app on it too). PORT takes
# precedence over API_PORT. For `npm run dev`, keep 8787 or export API_PORT in
# your shell: Vite's /api proxy reads it from the environment, not from .env.
# PORT=8787
# API_PORT=8787

# Interface to listen on. Unset = all interfaces (lets phones on your network
# open the app); 127.0.0.1 = this computer only.
# HOST=

# Folder with the built web app, served when NODE_ENV=production (`npm start`).
# STATIC_DIR=dist
