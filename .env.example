# Mode server configuration
# Copy to .env and fill in what you need. Every setting is optional: with no
# keys, Mode works fully offline (photos, Fine-tune paint, materials, lighting,
# plants and fixtures); only the AI features are turned off.
# `npm run dev` and `npm start` load .env automatically. Restart after changes.

# --- Claude (scene mapping, design plans, ideas & products, drawn assets) ------
# Anthropic API key from https://console.anthropic.com. Setting it turns AI on.
ANTHROPIC_API_KEY=

# Force AI on or off. "on" enables AI without ANTHROPIC_API_KEY, using other
# Anthropic credentials the SDK can find (ANTHROPIC_AUTH_TOKEN or a profile
# saved by `ant auth login`). "off" disables AI even when a key is set.
# MODE_AI=on

# Claude model used for every AI feature.
# CLAUDE_MODEL=claude-opus-5-5

# --- Image providers (photoreal variations, renders, photo-style assets) -----
# Each provider is available once its key is set; the app lets you pick one.
# IMAGE_PROVIDER chooses the default (openai | gemini), or "none" to turn image
# generation off. Photo-style library assets (transparent cut-outs) need OpenAI.
# IMAGE_PROVIDER=openai

# OpenAI Images (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=
# gpt-image-2.5-flare (everyday) or gpt-image-2.5-sunburst (most precise edits)
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# OpenAI-compatible endpoint (proxy or gateway). Default:
# OPENAI_BASE_URL=https://api.openai.com/v1
# Send input_fidelity=high for edits: auto (only models that accept it) | high | off
# OPENAI_INPUT_FIDELITY=auto

# Google Gemini image generation (https://aistudio.google.com/apikey).
# GOOGLE_API_KEY is accepted as an alternative name.
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Image API keys are optional: by default you render images yourself in the
# ChatGPT or Gemini app (manual hand-off) with your own subscription.

# Product search web tool version (older Claude models need web_search_20250305)
# CLAUDE_WEB_SEARCH_TOOL=web_search_20260209

# --- Access & limits -----------------------------------------------------------
# Shared secret for every /api request except /api/health. Strongly recommended
# whenever the server is reachable by other devices (phones on your Wi-Fi, a
# public host), so nobody else can spend your API credits. Enter the same value
# in the app under Settings > Server access token. The token is only ever sent
# in a request header, never in a URL (so it stays out of proxy logs).
# MODE_ACCESS_TOKEN=

# Host names this server answers to, besides IP addresses, localhost (and
# *.localhost), this computer's name (and <name>.local) and HOST. Requests for
# any other name in the Host header are refused with 403: that stops a web page
# from reaching Mode through DNS rebinding (its own domain pointed at your
# computer) and using your API keys or Downloads folder. Comma-separated; a
# leading dot allows a domain and all its subdomains. Add the name you use when
# Mode sits behind a reverse proxy that keeps the original Host header, or on a
# public domain, for example:
#   MODE_ALLOWED_HOSTS=mode.example.com
#   MODE_ALLOWED_HOSTS=.home.example.net,mode.tailnet-1234.ts.net
# "*" turns the check off (only behind a proxy that checks host names itself).
# MODE_ALLOWED_HOSTS=

# Max AI requests per client IP per 10 minutes (0 = unlimited).
# RATE_LIMIT_PER_10MIN=60

# Set to "true" only behind a trusted reverse proxy, so the rate limit uses the
# client address the proxy appended to X-Forwarded-For (the right-most entry)
# or X-Real-IP instead of the proxy's. A forwarded address is never taken as
# proof of "this computer": with TRUST_PROXY on, the Downloads watcher needs
# MODE_ACCESS_TOKEN.
# TRUST_PROXY=false

# --- Manual hand-off ------------------------------------------------------------
# While a hand-off waits, Mode can watch the folder your browser saves downloads
# to and import the ChatGPT / Gemini result as soon as you save it (hand-off
# card > "Watch my Downloads folder"). Default: ~/Downloads when it exists; a
# leading ~ means your home folder. Watching runs only while that option is on
# and stops after 30 minutes without activity. Only new image files are picked
# up, and only for a browser on this computer (or devices that send
# MODE_ACCESS_TOKEN).
# macOS protects ~/Downloads: if the hand-off card says macOS is blocking
# Mode, open System Settings > Privacy & Security > Files & Folders and turn on
# "Downloads Folder" for the app that runs the server (Terminal, iTerm,
# VS Code...), or add that app under Full Disk Access; then quit and reopen it
# and restart Mode.
# On Windows, write the full path without quotes (C:\Users\you\Downloads) or
# with forward slashes (C:/Users/you/Downloads): inside "double quotes" a \n in
# the path turns into a line break.
# HANDOFF_WATCH_DIR=~/Downloads

# --- Server ------------------------------------------------------------------
# Port of the API server (production serves the app on it too). PORT takes
# precedence over API_PORT (a value exported in your shell beats the same name
# here). `npm run dev` points Vite's /api proxy at the same port; the app itself
# stays on http://localhost:5173 (your projects are stored for that address).
# PORT=8787
# API_PORT=8787

# Interface to listen on. Unset = all interfaces (lets phones on your network
# open the app); 127.0.0.1 = this computer only. When HOST is a name, the
# server also answers to that name (see MODE_ALLOWED_HOSTS for others).
# HOST=

# Folder with the built web app, served when NODE_ENV=production (`npm start`).
# Its pages and scripts are sent cross-origin isolated (Cross-Origin-Opener-
# Policy: same-origin, Cross-Origin-Embedder-Policy: credentialless) so the
# on-device vision models run multi-threaded (the Vite dev server sends the
# same pair). If you put Mode behind a reverse proxy, let those two headers
# through; without them it still works, with single-threaded (slower) outline
# sharpening.
# STATIC_DIR=dist
