{
  "name": "mode",
  "version": "1.0.0",
  "description": "Mode — visualize home redesigns: paint, lighting, materials and landscaping on photos of your house, with an asset list you can enter or generate.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:site-data": "node scripts/build-site-data.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atg-y2k/Mode.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/atg-y2k/Mode/issues"
  },
  "homepage": "https://github.com/atg-y2k/Mode#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@hono/node-server": "^2.1.4",
    "@huggingface/transformers": "^4.3.1",
    "@techstark/opencv-js": "5.0.0-release.1",
    "chokidar": "^5.0.0",
    "exifr": "^7.1.3",
    "hono": "^4.13.13",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.21",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "suncalc": "^2.1.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
